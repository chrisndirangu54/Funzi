rules_version = '2';service cloud.firestore{match /databases/{database}/documents{function signedIn(){return request.auth!=null;}function self(uid){return signedIn()&&request.auth.uid==uid;}function role(r){return signedIn()&&get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role==r;}function platformAdmin(){return role("platform_admin");}match /users/{uid}{allow read,update:self(uid)||platformAdmin();allow create:self(uid);allow delete:platformAdmin();}match /learnerTwins/{uid}{allow read,write:self(uid)||platformAdmin();}match /studyPlans/{uid}/{doc=**}{allow read,write:self(uid)||platformAdmin();}match /masteryEvidence/{uid}/{doc=**}{allow read,write:self(uid)||platformAdmin();}match /curriculumNodes/{id}{allow read:if signedIn();allow write:if platformAdmin();}match /curriculumEdges/{id}{allow read:if signedIn();allow write:if platformAdmin();}match /leaderboardSnapshots/{id}{allow read:if signedIn();allow write:if platformAdmin();}match /safetyEvents/{id}{allow read,write:if platformAdmin();}match /contentProvenance/{id}{allow read:if signedIn();allow write:if platformAdmin();}match /{document=**}{allow read,write:if false;}}}