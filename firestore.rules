rules_version = '2';service cloud.firestore{match /databases/{database}/documents{function signedIn(){return request.auth!=null;}function self(uid){return signedIn()&&request.auth.uid==uid;}function user(){return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;}function role(r){return signedIn()&&user().role==r;}function admin(){return role("platform_admin");}function educator(){return role("teacher")||role("school_admin")||admin();}function parentLinked(learner){return signedIn()&&exists(/databases/$(database)/documents/parentLinks/$(learner+"_"+request.auth.uid));}match /users/{uid}{allow create:if self(uid);allow read,update:if self(uid)||admin();allow delete:if admin();}match /learnerTwins/{uid}{allow read:if self(uid)||parentLinked(uid)||educator();allow create,update:if self(uid)||admin();allow delete:if admin();}match /studyPlans/{uid}/{doc=**}{allow read:if self(uid)||parentLinked(uid)||educator();allow write:if self(uid)||admin();}match /masteryEvidence/{uid}/{doc=**}{allow read:if self(uid)||parentLinked(uid)||educator();allow write:if self(uid)||admin();}match /diagnostics/{uid}/{doc=**}{allow read:if self(uid)||parentLinked(uid)||educator();allow write:if self(uid)||admin();}match /tutorSessions/{uid}/{doc=**}{allow read:if self(uid);allow write:if false;}match /flashcards/{id}{allow read:if signedIn()&&resource.data.uid==request.auth.uid;allow write:if false;}match /curriculumNodes/{id}{allow read:if signedIn();allow write:if admin();}match /curriculumEdges/{id}{allow read:if signedIn();allow write:if admin();}match /classrooms/{cid}{allow create:if educator();allow read:if signedIn();allow update,delete:if educator();match /members/{uid}{allow read:if signedIn();allow create:if self(uid)||educator();allow update,delete:if educator();}match /assignments/{aid}{allow read:if signedIn();allow write:if educator();}}match /classroomMemberships/{id}{allow read:if signedIn()&&resource.data.uid==request.auth.uid;allow write:if educator();}match /parentLinks/{id}{allow read:if signedIn()&&(resource.data.parentId==request.auth.uid||resource.data.learnerId==request.auth.uid)||admin();allow create:if signedIn()&&request.resource.data.learnerId==request.auth.uid;allow update,delete:if signedIn()&&resource.data.learnerId==request.auth.uid||admin();}match /leaderboardSnapshots/{id}{allow read:if signedIn();allow write:if false;}match /safetyEvents/{id}{allow read,write:if admin();}match /contentProvenance/{id}{allow read:if signedIn();allow write:if admin();}match /{document=**}{allow read,write:if false;}}}