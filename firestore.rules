rules_version = '2';service cloud.firestore{match /databases/{database}/documents{function signedIn(){return request.auth!=null;}function self(uid){return signedIn()&&request.auth.uid==uid;}function user(){return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;}function role(r){return signedIn()&&user().role==r;}function admin(){return role("platform_admin");}function parentLinked(learner){return signedIn()&&exists(/databases/$(database)/documents/parentLinks/$(learner+"_"+request.auth.uid));}function teaches(learner){return signedIn()&&exists(/databases/$(database)/documents/teacherLearnerLinks/$(request.auth.uid+"_"+learner));}function canViewLearner(uid){return self(uid)||parentLinked(uid)||teaches(uid)||admin();}match /users/{uid}{allow create:if self(uid)&&request.resource.data.role=="learner";allow read:if self(uid)||admin();allow update:if self(uid)&&request.resource.data.role==resource.data.role||admin();allow delete:if admin();}match /learnerTwins/{uid}{allow read:if canViewLearner(uid);allow create,update:if self(uid)||admin();allow delete:if admin();}match /studyPlans/{uid}/{doc=**}{allow read:if canViewLearner(uid);allow write:if self(uid)||admin();}match /masteryEvidence/{uid}/{doc=**}{allow read:if canViewLearner(uid);allow write:if self(uid)||admin();}match /diagnostics/{uid}/{doc=**}{allow read:if canViewLearner(uid);allow write:if self(uid)||admin();}match /tutorSessions/{uid}/{doc=**}{allow read:if self(uid);allow write:if false;}match /flashcards/{id}{allow read:if signedIn()&&resource.data.uid==request.auth.uid;allow write:if false;}match /curriculumNodes/{id}{allow read:if signedIn();allow write:if admin();}match /curriculumEdges/{id}{allow read:if signedIn();allow write:if admin();}match /classrooms/{cid}{allow create:if role("teacher")||role("school_admin")||admin();allow read:if signedIn();allow update,delete:if signedIn()&&resource.data.teacherId==request.auth.uid||admin();match /members/{uid}{allow read:if signedIn();allow create:if self(uid)||(signedIn()&&get(/databases/$(database)/documents/classrooms/$(cid)).data.teacherId==request.auth.uid)||admin();allow update,delete:if signedIn()&&get(/databases/$(database)/documents/classrooms/$(cid)).data.teacherId==request.auth.uid||admin();}match /assignments/{aid}{allow read:if signedIn();allow write:if signedIn()&&get(/databases/$(database)/documents/classrooms/$(cid)).data.teacherId==request.auth.uid||admin();}}match /teacherLearnerLinks/{id}{allow read:if signedIn()&&(resource.data.teacherId==request.auth.uid||resource.data.learnerId==request.auth.uid)||admin();allow write:if false;}match /parentLinks/{id}{allow read:if signedIn()&&(resource.data.parentId==request.auth.uid||resource.data.learnerId==request.auth.uid)||admin();allow create:if signedIn()&&request.resource.data.learnerId==request.auth.uid;allow update,delete:if signedIn()&&resource.data.learnerId==request.auth.uid||admin();}match /leaderboardSnapshots/{id}{allow read:if signedIn();allow write:if false;}match /safetyEvents/{id}{allow read,write:if admin();}match /curriculumImports/{id}{allow read,write:if admin();}match /rateLimits/{id}{allow read,write:if false;}match /contentProvenance/{id}{allow read:if signedIn();allow write:if admin();}match /{document=**}{allow read,write:if false;}}}